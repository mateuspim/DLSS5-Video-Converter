FROM ubuntu:22.04

ARG LLVM_MINGW_VERSION=20260826
ARG LLVM_MINGW_SHA256=cee8d2ce3da5145ce4dc882e70d0b0719a783d53a99752c60948fc0659975a65

RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --retry 3 \
      "https://github.com/mstorsjo/llvm-mingw/releases/download/${LLVM_MINGW_VERSION}/llvm-mingw-${LLVM_MINGW_VERSION}-ucrt-ubuntu-22.04-x86_64.tar.xz" \
      --output /tmp/llvm-mingw.tar.xz \
    && echo "${LLVM_MINGW_SHA256}  /tmp/llvm-mingw.tar.xz" | sha256sum --check - \
    && mkdir -p /opt/llvm-mingw \
    && tar --extract --xz --file /tmp/llvm-mingw.tar.xz --strip-components=1 --directory /opt/llvm-mingw \
    && rm /tmp/llvm-mingw.tar.xz

ENV PATH="/opt/llvm-mingw/bin:${PATH}"
WORKDIR /src

ENTRYPOINT ["/src/native/build_native_cross.sh"]
